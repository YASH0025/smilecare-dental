# Secret used to sign the demo admin session cookie. Change it in any shared environment.
AUTH_SECRET=change-me-to-a-long-random-string
# Demo admin credentials (replace with a real identity provider later)
ADMIN_EMAIL=admin@smilecare.com
ADMIN_PASSWORD=admin123

# ── Email ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to use a free Ethereal test inbox (created automatically;
# emails are NOT delivered — open the preview link shown in the admin / server log).
# Fill these in to send real emails, e.g. Gmail: smtp.gmail.com / 465 / you@gmail.com / <16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
